{
  "schema": "rig_config/1",
  "note": "Joint limits are authored for the LEFT side in bone-local degrees; right-side y/z ranges are mirrored automatically. First matching pattern wins. Leg limits apply to the IK mechanism (MCH) bones, others to Limit Rotation on CTRL bones. Values are starting points to tune in validation scenario 2.",
  "armature_name": "RIG_{creature}",
  "wing_mode": "fk",
  "euler_order": "XYZ",
  "ctrl_parent_overrides": {"spine_01": "torso"},
  "joint_limits": {
    "pelvis": {"x": [-20, 20], "y": [-15, 15], "z": [-20, 20]},
    "spine_*": {"x": [-15, 15], "y": [-10, 10], "z": [-15, 15]},
    "neck_*": {"x": [-35, 35], "y": [-15, 15], "z": [-35, 35]},
    "head": {"x": [-45, 45], "y": [-25, 25], "z": [-45, 45]},
    "jaw": {"x": [-40, 3], "y": [0, 0], "z": [-3, 3]},
    "tail_*": {"x": [-30, 30], "y": [-10, 10], "z": [-40, 40]},
    "toe_*": {"x": [-60, 40], "y": [-5, 5], "z": [-15, 15]},
    "ftoe_*": {"x": [-60, 40], "y": [-5, 5], "z": [-15, 15]},
    "thigh_*": {"x": [-90, 90], "y": [-10, 10], "z": [-30, 30]},
    "shin_*": {"y": [0, 0], "z": [-10, 10]},
    "upperarm_*": {"x": [-90, 90], "y": [-10, 10], "z": [-30, 30]},
    "lowerarm_*": {"y": [0, 0], "z": [-10, 10]},
    "wing_humerus_*": {"x": [-80, 85], "y": [-40, 40], "z": [-30, 110]},
    "wing_forearm_*": {"x": [-20, 20], "y": [-20, 20], "z": [-20, 160]},
    "wing_d*": {"x": [-35, 35], "y": [-15, 15], "z": [-30, 130]}
  },
  "skinning": {"max_influences": 4, "falloff": 2.0, "smooth_iterations": 8, "smooth_factor": 0.5, "min_weight": 0.02},
  "rigid_tolerance": 0.01,
  "deformation_tests": [
    {"name": "wing_fold_L", "pose": {"CTRL-wing_humerus_L": {"rot": [20, 0, 60]}, "CTRL-wing_forearm_L": {"rot": [0, 0, 140]}, "CTRL-wing_d*_01_L": {"rot": [0, 0, 60]}}},
    {"name": "wing_upstroke_L", "pose": {"CTRL-wing_humerus_L": {"rot": [70, 0, 0]}}},
    {"name": "wing_downstroke_L", "pose": {"CTRL-wing_humerus_L": {"rot": [-60, 0, 0]}}},
    {"name": "tail_curl", "pose": {"CTRL-tail_*": {"rot": [0, 0, 15]}}},
    {"name": "neck_bend", "pose": {"CTRL-neck_*": {"rot": [20, 0, 10]}}},
    {"name": "crouch", "pose": {"CTRL-torso": {"loc": [0, 0, -0.3]}}}
  ],
  "fbx": {"apply_scale_options": "FBX_SCALE_UNITS", "global_scale": 1.0, "axis_forward": "-Z", "axis_up": "Y"}
}
